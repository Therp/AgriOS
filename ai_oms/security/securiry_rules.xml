<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
	
	<record id="farmer_group_comp_rule" model="ir.rule">
		<field name="name">Farmer Group Company Rule</field>
		<field name="model_id" ref="model_farmer_group"/>
		<field name="domain_force">[('company_id','in',company_ids)]</field>
	</record>
	
	<record id="tc_sale_order_rule" model="ir.rule">
		<field name="name">Technical Coordinator Sales Orders Rule</field>
		<field name="model_id" ref="sale.model_sale_order"/>
		<field name="domain_force">[('partner_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_sale_salesman_tc'))]"/>
	</record>
	
	<record id="tc_sale_order_line_rule" model="ir.rule">
		<field name="name">Technical Coordinator Order Lines</field>
		<field name="model_id" ref="sale.model_sale_order_line"/>
		<field name="domain_force">[('order_id.partner_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_sale_salesman_tc'))]"/>
	</record>
	
	<record id="tc_purchase_order_rule" model="ir.rule">
		<field name="name">Technical Coordinator Purchase Orders Rule</field>
		<field name="model_id" ref="purchase.model_purchase_order"/>
		<field name="domain_force">[('partner_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_purchase_salesman_tc'))]"/>
	</record>
	
	<record id="manager_purchase_order_rule" model="ir.rule">
		<field name="name">Manager Purchase Orders Rule</field>
		<field name="model_id" ref="purchase.model_purchase_order"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
	</record>
	
	<record id="tc_stock_picking_rule" model="ir.rule">
		<field name="name">Technical Coordinator Stock Picking Rule</field>
		<field name="model_id" ref="stock.model_stock_picking"/>
		<field name="domain_force">[('partner_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_stock_salesman_tc'))]"/>
	</record>
	<record id="manager_stock_picking_rule" model="ir.rule">
		<field name="name">Manager Stock Picking Rule</field>
		<field name="model_id" ref="stock.model_stock_picking"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
	</record>
	
	<record id="tc_res_partner_rule" model="ir.rule">
		<field name="name">Technical Coordinator Contact Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_tc'))]"/>
	</record>
	<record id="manager_res_partner_rule" model="ir.rule">
		<field name="name">Manager Contact Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('id','not in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
	</record>
	
	<record id="oms_iu_res_partner_rule" model="ir.rule">
		<field name="name">Internal User OMS Partner Edit Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('is_outgrower','=',False)]</field>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="perm_read" eval="False"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>
	<record id="oms_user_res_partner_rule" model="ir.rule">
		<field name="name">OMS User Partner Edit Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('is_outgrower','=',True), ('outgrower_stage','=','draft')]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_user'))]"/>
		<field name="perm_read" eval="False"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>
	<record id="oms_manager_res_partner_rule" model="ir.rule">
		<field name="name">OMS Manager Partner Edit Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('is_outgrower','=',True), ('outgrower_stage','=','verified')]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
		<field name="perm_read" eval="False"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>
	
	<record id="tc_certified_farmer_rule" model="ir.rule">
		<field name="name">Technical Coordinator Farmer Certification Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_certification"/>
		<field name="domain_force">[('outgrower_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_tc'))]"/>
	</record>
	<record id="manager_certified_farmer_rule" model="ir.rule">
		<field name="name">Manager Farmer Certification Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_certification"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
	</record>
	
	<record id="tc_offtake_agreement_rule" model="ir.rule">
		<field name="name">Technical Coordinator Offtake Agreement Rule</field>
		<field name="model_id" ref="ai_oms.model_offtake_agreement"/>
		<field name="domain_force">[('outgrower_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_tc'))]"/>
	</record>
	<record id="manager_offtake_agreement_rule" model="ir.rule">
		<field name="name">Manager Offtake Agreement Rule</field>
		<field name="model_id" ref="ai_oms.model_offtake_agreement"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
	</record>
	
	<record id="tc_farmer_group_rule" model="ir.rule">
		<field name="name">Technical Coordinator Farmer Group Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_group"/>
		<field name="domain_force">[('coop_id.community_facilitator_id','=',user.id)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_tc'))]"/>
	</record>
	<record id="manager_farmer_group_rule" model="ir.rule">
		<field name="name">Manager Farmer Group Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_group"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
	</record>
	
	<record id="tc_farmer_training_rule" model="ir.rule">
		<field name="name">Technical Coordinator Farmer Training Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_training"/>
		<field name="domain_force">[('coop_id','in',user.cooperative_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_tc'))]"/>
	</record>
	<record id="manager_farmer_training_rule" model="ir.rule">
		<field name="name">Manager Farmer Training Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_training"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
	</record>
	
	<record id="tc_farmer_interaction_rule" model="ir.rule">
		<field name="name">Technical Coordinator Farmer Interaction Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_interaction"/>
		<field name="domain_force">[('outgrower_id','in',user.resposible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_tc'))]"/>
	</record>
	<record id="manager_farmer_interaction_rule" model="ir.rule">
		<field name="name">Manager Farmer Interaction Rule</field>
		<field name="model_id" ref="ai_oms.model_farmer_interaction"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('ai_oms.group_oms_manager'))]"/>
	</record>
	
	<record id="offtake_agreement_comp_rule" model="ir.rule">
		<field name="name">Offtake Agreement multi-company</field>
		<field name="model_id" ref="model_offtake_agreement"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
	
</odoo>