<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
	
	<record id="module_category_ai_oms" model="ir.module.category">
		<field name="name">OMS</field>
		<field name="description">Ougrower Management Rights</field>
		<field name="sequence">40</field>
	</record>

	<record id="module_category_ai_oms_inventory" model="ir.module.category">
		<field name="name">OMS Inventory</field>
		<field name="description">OMS Related Inventory Rights</field>
		<field name="sequence">40</field>
	</record>
	
	<record id="group_oms_readonly" model="res.groups">
		<field name="name">Readonly</field>
		<field name="category_id" ref="module_category_ai_oms"/>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
	</record>
	
	<record id="group_oms_user" model="res.groups">
		<field name="name">User</field>
		<field name="category_id" ref="module_category_ai_oms"/>
		<field name="implied_ids" eval="[(4, ref('group_oms_readonly'))]"/>
	</record>
	
	<record id="group_oms_tc" model="res.groups">
		<field name="name">Technical Coordinator</field>
		<field name="category_id" ref="module_category_ai_oms"/>
		<field name="implied_ids" eval="[(4, ref('group_oms_user'))]"/>
	</record>
	
	<record id="group_oms_manager" model="res.groups">
		<field name="name">Manager</field>
		<field name="category_id" ref="module_category_ai_oms"/>
		<field name="implied_ids" eval="[(4, ref('group_oms_tc'))]"/>
	</record>
	
	<record id="group_oms_admin" model="res.groups">
		<field name="name">Administrator</field>
		<field name="category_id" ref="module_category_ai_oms"/>
		<field name="implied_ids" eval="[(4, ref('group_oms_manager'))]"/>
		<field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
	</record>
	
	<record id="group_sale_salesman_tc" model="res.groups">
		<field name="name">User: Technical Coordinator</field>
		<field name="category_id" ref="base.module_category_sales_sales"/>
		<field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
		<field name="comment">the user will have access to records of the cooperative farmers he/she coordinates.</field>
	</record>

	<record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
		<field name="implied_ids" eval="[(6, 0, [ref('ai_oms.group_sale_salesman_tc')])]"/>
	</record>
	
	<record id="group_purchase_salesman_tc" model="res.groups">
		<field name="name">User: Technical Coordinator</field>
		<field name="category_id" ref="base.module_category_inventory_purchase"/>
		<field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
		<field name="comment">the user will have access to records of the cooperative farmers he/she coordinates.</field>
	</record>

	<record id="purchase.group_purchase_manager" model="res.groups">
		<field name="implied_ids" eval="[(6, 0, [ref('ai_oms.group_purchase_salesman_tc')])]"/>
	</record>

	<record id="group_stock_salesman_tc" model="res.groups">
		<field name="name">User: Technical Coordinator</field>
		<field name="category_id" ref="module_category_ai_oms_inventory"/>
		<field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
		<field name="comment">the user will have access to records of the cooperative farmers he/she coordinates.</field>
	</record>
	
   	<record id="group_offtake_agreement" model="res.groups">
		<field name="name">OMS - Manage Offtake Agreements</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_farmers_training" model="res.groups">
		<field name="name">OMS - Manage Farmers Training</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_farmers_interactions" model="res.groups">
		<field name="name">OMS - Manage Farmers Interactions</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_farmers_interactions" model="res.groups">
		<field name="name">OMS - Manage Farmers Interactions</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_farmers_certifications" model="res.groups">
		<field name="name">OMS - Manage Farmers Certifications</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_seed_varieties" model="res.groups">
		<field name="name">OMS - Manage Seed Varieties</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_plot_management" model="res.groups">
		<field name="name">OMS - Plot Management</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_payments_in_kind" model="res.groups">
		<field name="name">OMS - Payments In Kind</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="group_plot_maps" model="res.groups">
		<field name="name">OMS - Plot Maps</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
</odoo>