<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	
	<record id="view_move_form" model="ir.ui.view">
		<field name="name">account.move.form</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="/form" position="inside">
				<field name="payment_in_kind" invisible="True"/>
			</xpath>
			<xpath expr="//group[@id='header_left_group']" position="inside">
				<field name="payment_in_kind" readonly="posted_before" invisible="move_type != 'out_invoice'" groups="ai_oms.group_payments_in_kind"/>
			</xpath>
			<xpath expr="//group[@id='header_right_group']//field[@name='journal_id']" position="attributes">
				<attribute name="context">{'payment_in_kind_domain': payment_in_kind}</attribute>
			</xpath>
		</field>
	</record>
	
</odoo>