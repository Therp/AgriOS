<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	<record id="multiple_set_contracted_mapped_qty_wizard_wizard_form" model="ir.ui.view">
		<field name="name">multiple.set.contracted.mapped.qty.wizard.form</field>
		<field name="model">multiple.set.contracted.mapped.qty.wizard</field>
		<field name="arch" type="xml">
			<form>
				<p>Are you sure you want to update the contracted acreage for all the selected contracts?</p>
				
				<group>
					<field name="contract_ids" nolabel="1" colspan="2">
						<list string="Draft Contracts">
			                <field name="outgrower_id" context="{'form_view_ref': 'ai_oms.view_outgrower_form'}"/>
			                <field name="season_id"/>
			                <field name="contracted_crop_id"/>
			                <field name="unutilized_acreage"/>
			                <field name="contracted_farm_acreage"/>
			                <field name="contract_stage"/>
			            </list>
					</field>
				</group>
				
				<footer>
					<button string="Update Contracts" name="update_contracts" type="object" class="oe_highlight" data-hotkey="q"/>
					<button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
				</footer>
			</form>
		</field>
	</record>
	
</odoo>