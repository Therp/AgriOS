<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form - agrios_plot</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="agrios_farmer.view_partner_form"/>
        <field name="priority" eval="128"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="farm_detail" invisible="not is_farmer" string="Farm Details">
                    <group>
                        <group>
                            <field name="crop_product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
