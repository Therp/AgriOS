<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form - agrios_plot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="agrios_farmer.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='farmer_interactions']" position="before">
                <setting
                    id="seed_varieties"
                    help="Allows the management of seeds varieties to product a harvestable product."
                >
                    <field name="group_seed_varieties"/>
                </setting>
            </xpath>
            <xpath expr="//app[@name='agrios']" position="before">
                <block title="Farm">
                    <setting
                        id="land_area_uom"
                        string="Land Size UoM"
                        help="Set the unit of measure that the area of farms are measured."
                    >
                        <div class="content-group">
                            <field
                                name="land_area_uom"
                                options="{'no_create': True}"
                                readonly="land_area_uom == True"
                                class="o_light_label"
                            />
                        </div>
                    </setting>
                    <setting
                        id="max_plot_size"
                        string="Max Plot Size"
                        help="Leave the value as 0.0 to allow any farm size to be set."
                    >
                        <div class="content-group">
                            <field name="max_plot_size" class="o_light_label"/>
                        </div>
                    </setting>
                    <setting
                        id="plots_management"
                        string="Complex Plot Management"
                        help="Allows the creation of plot records (which determine the total acreage of the Farmer),
                        the registration of trees planted, and the use several crops per plot of land"
                     >
                        <field name="group_plot_management"/>
                        <div class="content-group">
                            <div class="mt16" invisible="not group_plot_management">
                                <div>
                                    <field name="group_plot_maps" class="w-auto"/>
                                    <label for="group_plot_maps"/>
                                    <span
                                        class="o_doc_link"
                                        style="cursor: help; margin-left: -7px;"
                                        title="Allows farmer plots to be recorded on a map."
                                    />
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
