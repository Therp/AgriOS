<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search - agrios_plot</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="mode">primary</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <separator/>
                <filter
                    string="Seed Varieties"
                    name="filter_seed_product"
                    domain="[('seed_product','=',True)]"
                    groups="agrios_plot.group_seed_varieties"
                />
                <filter
                    string="Input Products"
                    name="filter_input_product"
                    domain="[('input_product','=',True)]"
                />
                <filter
                    string="Crop Products"
                    name="filter_harvest_product"
                    domain="[('crop_product','=',True)]"
                />
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="name">product.template.product.kanban - agrios_plot</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="/kanban" position="attributes">
                <attribute name="default_order">is_favorite desc, seed_product desc, crop_product desc, input_product
                    desc desc, name
                </attribute>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="input_product"/>
                <field name="crop_product"/>
                <field name="seed_product"/>
            </xpath>
            <xpath expr="//field[@name='list_price']/.." position="before">
                <div t-if="record.seed_product.raw_value === true" class="mt-1" style="background-color: #00a3ff54;">
                    Seed Variety
                </div>
                <div t-if="record.input_product.raw_value === true" class="mt-1" style="background-color: #edff7f54;">
                    Input Product
                </div>
                <div t-if="record.crop_product.raw_value === true" class="mt-1" style="background-color: #82ff7f54;">
                    Crop Product
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">view.product.template.form - agrios_plot</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="inside">
                <field name="seed_product" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="agrios_page"
                    string="Farming Details"
                    groups="agrios_farmer.group_agrios_readonly"
                >
                    <group>
                        <group
                            string="Input Info"
                            invisible="type != 'consu' or crop_product or seed_product"
                        >
                            <field
                                name="input_product"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                            />
                            <label for="qty_per_acreage" invisible="not input_product"/>
                            <div class="o_row mw-50" invisible="not input_product">
                                <field
                                    name="qty_per_acreage"
                                    class="oe_inline o_hr_narrow_field"
                                    nolabel="1"
                                />
                                <div>
                                    <field name="land_area_uom"/>
                                </div>
                            </div>
                        </group>
                        <group string="Crop Info" invisible="type != 'consu' or input_product">
                            <field
                                name="crop_product"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                            />
                            <field name="harvest_product_type" invisible="not crop_product"/>
                            <field name="maturity_days" invisible="not crop_product"/>
                            <label
                                groups="agrios_plot.group_plot_management"
                                for="estimated_yield"
                                invisible="not crop_product or harvest_product_type == 'tree_crop'"
                            />
                            <div groups="agrios_plot.group_plot_management"
                                 invisible="not crop_product or harvest_product_type == 'tree_crop'">
                                <field name="estimated_yield" class="oe_inline" nolabel="1"/>
                                <field name="land_area_uom" class="oe_inline"/>
                            </div>
                            <label for="estimated_yield" groups="!agrios_plot.group_plot_management"/>
                            <div groups="!agrios_plot.group_plot_management">
                                <field
                                    name="estimated_yield"
                                    class="oe_inline"
                                    nolabel="1"
                                />
                                <field
                                    name="land_area_uom"
                                    class="oe_inline"
                                />
                            </div>
                            <separator
                                string="Anual Tree Yield"
                                invisible="not crop_product or harvest_product_type != 'tree_crop'"
                                groups="agrios_plot.group_plot_management"
                            />
                            <field
                                name="tree_yield_ids"
                                nolabel="1"
                                colspan="2"
                                invisible="not crop_product or harvest_product_type != 'tree_crop'"
                                groups="agrios_plot.group_plot_management"
                            >
                                <list editable="bottom">
                                    <control>
                                        <create name="add_line_control" string="New Yield"/>
                                    </control>
                                    <field name="age"/>
                                    <field name="annual_yield"/>
                                </list>
                            </field>
                            <field
                                name="related_inputs_ids"
                                widget="many2many_tags"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                                invisible="not crop_product"
                            />
                            <field
                                name="seed_ids"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                                widget="many2many_tags"
                                invisible="not crop_product"
                                help="To set seed varieties, select this harvest product as the harverst crop of the seed..."
                                groups="agrios_plot.group_seed_varieties"
                            />
                        </group>
                        <group
                            string="Seed Info"
                            invisible="type != 'consu' or input_product"
                            groups="agrios_plot.group_seed_varieties"
                        >
                            <field
                                name="seed_product"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                            />
                            <field
                                name="crop_product_id"
                                required="seed_product"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                                invisible="not seed_product"
                                context="{'default_harvest_product': True}"
                            />
                            <label for="qty_per_acreage" invisible="not seed_product"/>
                            <div class="o_row mw-50" invisible="not seed_product">
                                <field
                                    name="qty_per_acreage"
                                    class="oe_inline o_hr_narrow_field"
                                    nolabel="1"
                                />
                                <div>
                                    <field name="land_area_uom"/>
                                </div>
                            </div>
                            <field
                                name="related_inputs_ids"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                                widget="many2many_tags"
                                invisible="not seed_product"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
