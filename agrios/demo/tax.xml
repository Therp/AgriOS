<odoo>
  <data noupdate="1">
        <!-- Ensure only KES is active -->
    <record id="base.KES" model="res.currency">
      <field name="active">True</field>
    </record>

    <!-- Deactivate USD -->
    <record id="base.USD" model="res.currency">
      <field name="active">False</field>
    </record>

    <!-- VAT Tax Group -->
    <record id="tax_group_vat" model="account.tax.group">
      <field name="name">VAT</field>
    </record>

    <!-- Sales VAT (16%) -->
    <record id="tax_sale_vat_16" model="account.tax">
      <field name="name">Sales VAT (16%)</field>
      <field name="amount">16</field>
      <field name="amount_type">percent</field>
      <field name="type_tax_use">sale</field>
      <field name="tax_group_id" ref="tax_group_vat"/>
      <field name="country_id" ref="base.ke"/>
    </record>

    <!-- Purchase VAT (16%) -->
    <record id="tax_purchase_vat_16" model="account.tax">
      <field name="name">Purchase VAT (16%)</field>
      <field name="amount">16</field>
      <field name="amount_type">percent</field>
      <field name="type_tax_use">purchase</field>
      <field name="tax_group_id" ref="tax_group_vat"/>
      <field name="country_id" ref="base.ke"/>
    </record>

  </data>
</odoo>
