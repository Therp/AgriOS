<odoo noupdate="1">
    <!-- Ensure only KES is active -->
    <record id="base.KES" model="res.currency">
        <field name="active">True</field>
    </record>

    <!-- Deactivate USD -->
    <record id="base.USD" model="res.currency">
        <field name="active">False</field>
    </record>

    <!-- VAT Tax Group -->
    <record id="tax_group_vat" model="account.tax.group">
        <field name="name">VAT</field>
        <field name="country_id" ref="base.ke"/>
    </record>

    <!-- Sales VAT (16%) -->
    <record id="tax_sale_vat_16" model="account.tax">
        <field name="name">Sales VAT (16%)</field>
        <field name="amount">16</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">sale</field>
        <field name="tax_group_id" ref="tax_group_vat"/>
        <field name="country_id" ref="base.ke"/>
    </record>

    <!-- Purchase VAT (16%) -->
    <record id="tax_purchase_vat_16" model="account.tax">
        <field name="name">Purchase VAT (16%)</field>
        <field name="amount">16</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">purchase</field>
        <field name="tax_group_id" ref="tax_group_vat"/>
        <field name="country_id" ref="base.ke"/>
    </record>

    <!-- Accounts -->
    <record id="account_income" model="account.account">
        <field name="name">444000 Product Sales</field>
        <field name="code">444000</field>
        <field name="internal_group">income</field>
    </record>

    <record id="account_expense" model="account.account">
        <field name="name">644000 Expenses</field>
        <field name="code">644000</field>
        <field name="internal_group">expense</field>
    </record>

    <record id="account_valuation" model="account.account">
        <field name="name">444100 Stock Valuation</field>
        <field name="code">444100</field>
        <field name="internal_group">asset</field>
    </record>

    <record id="account_input" model="account.account">
        <field name="name">444200 Stock Interim (Received)</field>
        <field name="code">444200</field>
        <field name="internal_group">asset</field>
    </record>

    <record id="account_output" model="account.account">
        <field name="name">444300 Stock Interim (Delivered)</field>
        <field name="code">444300</field>
        <field name="internal_group">asset</field>
    </record>

    <!-- Journal -->
    <record id="inventory_valuation_journal" model="account.journal">
        <field name="name">Inventory Valuation</field>
        <field name="type">general</field>
        <field name="code">AGINV</field>
    </record>
</odoo>
