<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Weight UoM Category -->
    <record id="demo_uom_categ_weight" model="uom.category">
      <field name="name">Agri Weight</field>
    </record>
    <record id="demo_uom_categ_unit" model="uom.category">
      <field name="name">Agri Unit</field>
    </record>

    <!-- Kilogram Unit -->
    <record id="demo_uom_kg" model="uom.uom">
      <field name="name">kg</field>
      <field name="category_id" ref="demo_uom_categ_weight"/>
      <field name="uom_type">reference</field>
      <field name="factor_inv">1.0</field>
      <field name="rounding">0.01</field>
    </record>
    <record id="demo_uom_units" model="uom.uom">
      <field name="name">Unit</field>
      <field name="category_id" ref="demo_uom_categ_unit"/>
      <field name="uom_type">reference</field>
      <field name="factor_inv">1.0</field>
      <field name="rounding">0.01</field>
    </record>

  </data>
</odoo>
