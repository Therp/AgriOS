<odoo>
    <data noupdate="1">
        <!-- Ensure only KES is active -->
        <record id="base.KES" model="res.currency">
            <field name="active">True</field>
        </record>

        <!-- Deactivate USD -->
        <record id="base.USD" model="res.currency">
            <field name="active">False</field>
        </record>

        <!-- VAT Tax Group -->
        <record id="tax_group_vat" model="account.tax.group">
            <field name="name">VAT</field>
            <field name="country_id" ref="base.ke"/>
        </record>

        <!-- Sales VAT (16%) -->
        <record id="tax_sale_vat_16" model="account.tax">
            <field name="name">Sales VAT (16%)</field>
            <field name="amount">16</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_vat"/>
            <field name="country_id" ref="base.ke"/>
        </record>

        <!-- Purchase VAT (16%) -->
        <record id="tax_purchase_vat_16" model="account.tax">
            <field name="name">Purchase VAT (16%)</field>
            <field name="amount">16</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="tax_group_vat"/>
            <field name="country_id" ref="base.ke"/>
        </record>
        <!-- Weight UoM Category -->
        <record id="demo_uom_categ_weight" model="uom.category">
            <field name="name">Agri Weight</field>
        </record>
        <record id="demo_uom_categ_unit" model="uom.category">
            <field name="name">Agri Unit</field>
        </record>

        <!-- Kilogram Unit -->
        <record id="demo_uom_kg" model="uom.uom">
            <field name="name">kg</field>
            <field name="category_id" ref="demo_uom_categ_weight"/>
            <field name="uom_type">reference</field>
            <field name="factor_inv">1.0</field>
            <field name="rounding">0.01</field>
        </record>
        <record id="demo_uom_units" model="uom.uom">
            <field name="name">Unit</field>
            <field name="category_id" ref="demo_uom_categ_unit"/>
            <field name="uom_type">reference</field>
            <field name="factor_inv">1.0</field>
            <field name="rounding">0.01</field>
        </record>


