<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
	
	<record id="close_expired_contracts_cron" model="ir.cron">
        <field name="name">AgriOS - Close Expired Contracts</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="model_id" ref="model_offtake_agreement"/>
        <field name="code">model._cron_close_expired_contracts()</field>
        <field name="state">code</field>
    </record>
	
</odoo>