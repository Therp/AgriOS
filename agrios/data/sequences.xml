<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
	
	<record id="farmer_seq" model="ir.sequence">
        <field name="name">Farmer</field>
        <field name="code">farmer</field>
        <field name="prefix">OF</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
	
    <record id="farmer_contract_seq" model="ir.sequence">
        <field name="name">Farmer Contract</field>
        <field name="code">farmer.contract</field>
        <field name="prefix">OA</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
	
</odoo>