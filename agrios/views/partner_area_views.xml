<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="farmer_plot_search" model="ir.ui.view">
        <field name="name">farmer.plot.search</field>
        <field name="model">farmer.plot</field>
        <field name="arch" type="xml">
            <search string="Plots">
                <field name="name"/>
                <field name="farmer_id"/>
                <separator/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <group expand="0" name="group_by" string="Group By">
                    <filter string="Farmer" name="groupby_farmer_id" context="{'group_by': 'farmer_id'}"/>
                </group>
            </search>
        </field>
    </record>

	<record id="farmer_plot_tree" model="ir.ui.view">
        <field name="name">farmer.plot.tree</field>
        <field name="model">farmer.plot</field>
        <field name="arch" type="xml">
            <list string="Plots">
                <field name="farmer_id"/>
                <field name="is_owner" optional="hide"/>
                <field name="name" optional="show"/>
                <field name="plot_size" sum="Total" optional="show"/>
                <field name="plot_description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="farmer_plot_form" model="ir.ui.view">
        <field name="name">farmer.plot.form</field>
        <field name="model">farmer.plot</field>
        <field name="arch" type="xml">
            <form string="Plot">
            	<field name="country_code" invisible="1"/>

                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" placeholder="Name"/>
                            <field name="farmer_id" context="{'default_is_farmer': True}"
                                   invisible="context.get('plot_partner_invisible')"
                                   options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                                   readonly="context.get('plot_partner_readonly')"
                                   force_save="1"/>
                            <field name="is_owner"/>
                            <label for="plot_size"/>
                            <div class="o_row">
                                <field name="plot_size" class="oe_inline" nolabel="1"/>
                                <field name="plot_uom_id" force_save="1" options="{'no_open': True}"/>
                            </div>
                            <field name="plot_condition"/>
                            <field name="intercropping"/>
                        </group>
                        <group>
                            <field name="year_established"/>
                            <field
                                name="country_id"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                            />
                            <field name="main_road"/>
                            <field name="main_road_distance"/>
                            <field name="gps_location" widget="url"/>
                        </group>
                    </group>

                    <notebook>
                    	<page name="plot_map_page" string="Plot Map" groups="agrios.group_plot_maps">
                            <group>
                                <field name="plot_polygon" widget="map" nolabel="1" colspan="2" options="{'polyline_inactive': True, 'rectangle_inactive': True, 'circle_inactive': True, 'marker_inactive': True, 'area_field': 'plot_size', 'area_measurement': 'acres'}"/>
                            </group>
                    	</page>
                    	<page name="subplots_page" string="Sub Plots">
                    		<field name="subplot_ids">
	                            <list>
	                                <field name="crop_product_id" options="{'no_create': True}"/>
	                                <field name="acreage"/>
	                                <field name="annual_estimated_yield"/>
	                            </list>
	                            <form>
	                                <sheet>
	                                    <group>
	                                        <group>
	                                            <field name="crop_product_id"  options="{'no_open': True,'no_quick_create': True,'no_create': True}"/>
	                                            <field name="product_type"/>
	                                            <field name="acreage"/>
	                                        </group>
	                                        <group>
	                                            <field name="year_of_plantation"/>
	                                            <field name="age"/>
	                                            <field name="number_of_trees" invisible="product_type != 'tree_crop'"/>
	                                            <field name="annual_estimated_yield"/>
	                                        </group>
	                                    </group>
	                                </sheet>
	                            </form>
	                        </field>
                    	</page>
                    	<page name="desc_page" string="Plot Description">
                    		<field name="plot_description" placeholder="Internal description of the plot..."/>
                    	</page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="farmer_plot_action" model="ir.actions.act_window">
        <field name="name">Farmer Plots</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">farmer.plot</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
