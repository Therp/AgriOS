<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<!-- Training Topics -->

    <record id="view_training_topic_tree" model="ir.ui.view">
        <field name="name">view.training.topics.tree</field>
        <field name="model">training.topic</field>
        <field name="arch" type="xml">
            <list sample="1" editable="top">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

	<record id="view_training_topic_form" model="ir.ui.view">
        <field name="name">view.training.topic.form</field>
        <field name="model">training.topic</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_farmer_training_topics" model="ir.actions.act_window">
        <field name="name">Training Topics</field>
        <field name="res_model">training.topic</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Training Topic
            </p>
            <p>
                Odoo helps you easily track all Training Topics
            </p>
        </field>
    </record>


	<!-- Farmers Training -->

	<record id="view_farmer_training_search" model="ir.ui.view">
        <field name="name">view.farmer.training.search</field>
        <field name="model">farmer.training</field>
        <field name="arch" type="xml">
            <search>
                <field name="trainer_id"/>
                <field name="training_location"/>
                <separator/>
                <filter string="Planned" name="planned" domain="[('training_state', '=', 'planned')]"/>
                <filter string="Done" name="done" domain="[('training_state', '=', 'done')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter name="groupby_training_location" context="{'group_by': 'training_location'}"/>
                    <filter name="groupby_trainer_id" context="{'group_by': 'trainer_id'}"/>
                    <filter name="groupby_training_state" context="{'group_by': 'training_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_farmer_training_tree" model="ir.ui.view">
        <field name="name">view.farmer.training.tree</field>
        <field name="model">farmer.training</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="training_date"/>
                <field name="training_ids" widget="many2many_tags"/>
                <field name="trainer_id"/>
                <field name="training_location"/>
                <field name="farmer_group_ids" widget="many2many_tags"/>
                <field name="count_training_participants"/>
                <field name="training_state"/>
            </list>
        </field>
    </record>

    <record id="view_farmer_training_calendar" model="ir.ui.view">
        <field name="name">view.farmer.training.calendar</field>
        <field name="model">farmer.training</field>
        <field name="arch" type="xml">
            <calendar string="Farmer Training" create="0" mode="month" date_start="training_date" quick_create="0">
                <field name="name"/>
                <field name="training_content"/>
            </calendar>
        </field>
    </record>

    <record id="view_farmer_training_form" model="ir.ui.view">
        <field name="name">view.farmer.training.form</field>
        <field name="model">farmer.training</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <field name="active" invisible="1"/>
                    <button name="action_done" type="object" string="Mark as Done" invisible="training_state not in ('planned')" class="btn-primary" data-hotkey="d" confirm="Are you Sure you want to Mark as Done?" groups="agrios.group_agrios_user"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="training_state not in ('planned')" data-hotkey="z" confirm="Are you Sure you want to Cancel?" groups="agrios.group_agrios_user"/>
                    <button name="action_planned" type="object" string="Reset to Planned" invisible="training_state in ('planned')" data-hotkey="w" confirm="Are you Sure you want to Reset to Planned?" groups="agrios.group_agrios_user"/>
                    <field name="training_state" clickable="false" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>

                    <h1><field name="training_ids" options="{'no_create': True}" placeholder="Trainings..." widget="many2many_tags" style="width: 100%;"/></h1>

                    <group>
                        <group>
                            <field name="training_date"/>
                            <field name="training_start_time" widget="float_time"/>
                            <field name="training_duration" widget="float_time"/>
                            <field name="trainer_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="training_type"/>
                        </group>
                        <group>
                            <field name="training_location"/>
                            <field name="farmer_group_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="country_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Participants">
                            <field name="training_participants_ids" options="{'no_create': True}" readonly="training_state != 'planned'" >
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="farmer_id_number"/>
                                    <field name="gender"/>
                                    <field name="farmer_group_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary">
                            <field name="training_content" placeholder="Description of the training..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_farmer_trainings" model="ir.actions.act_window">
        <field name="name">Farmer Trainings</field>
        <field name="res_model">farmer.training</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Training Invite
            </p>
            <p>
                Odoo helps you easily track all Training activities
            </p>
        </field>
    </record>

</odoo>
