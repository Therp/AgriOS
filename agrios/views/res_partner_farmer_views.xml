<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_partner_form" model="ir.ui.view">
		<field name="name">res.partner.form</field>
		<field name="model">res.partner</field>
		<field name="inherit_id" ref="base.view_partner_form"/>
		<field name="arch" type="xml">
			<xpath expr="//page" position="inside">
				<field name="is_farmer" invisible="1"/>
				<field name="count_certifications" invisible="1"/>
				<field name="certified" invisible="1"/>
				<field name="active" invisible="1"/>
				<field name="currency_id" invisible="1"/>
				<field name="farmer_requires_contract" invisible="1"/>
				<field name="can_order_inputs" invisible="1"/>
				<field name="can_order_inputs_confirm" invisible="1"/>
				<field name="can_register_offtakes" invisible="1"/>
				<field name="can_register_offtakes_confirm" invisible="1"/>
				<field name="has_expired_contract" invisible="1" groups="agrios.group_farmer_contract"/>
				<field name="plot_ids" invisible="1"/>
				<field name="loc_area_max_level" invisible="1"/>
			</xpath>
			<!-- Hide main details if is_farmer-->
			<xpath expr="//form[1]/sheet[1]/group[1]/group[1]" position="attributes">
				<attribute name="invisible">is_farmer == True</attribute>
			</xpath>
			<xpath expr="//field[@name='company_type']" position="attributes">
				<attribute name="invisible">is_farmer == True</attribute>
			  </xpath>
			<xpath expr="//form[1]/sheet[1]/group[1]/group[2]" position="attributes">
				<attribute name="invisible">is_farmer == True</attribute>
			  </xpath>
			<xpath expr="//page[@name='contact_addresses']" position="attributes">
				<attribute name="invisible">is_farmer == True</attribute>
			  </xpath>
			<xpath expr="//page[@name='sales_purchases']" position="attributes">
				<attribute name="invisible">is_farmer == True</attribute>
			  </xpath>
			<xpath expr="//page[@name='accounting']" position="attributes">
				<attribute name="invisible">['|',('is_farmer', '=', True),('&amp;',('is_company', '=', False),('parent_id', '!=', False))]</attribute>
			  </xpath>
			<xpath expr="//page[@name='internal_notes']" position="after">
				<page name="agrios_page" string="AgriOS" groups="agrios.group_agrios_readonly">
					<group>
						<field name="farmer_requires_contract" invisible="not is_farmer" groups="agrios.group_farmer_contract"/>
                    	<field name="is_farmer_trainer" groups="agrios.group_farmers_training"/>
						<field name="is_farmer" invisible="0"/>
					</group>
                </page>
			</xpath>
<!--			Header-->
			<xpath expr="//sheet" position="before">
				<header>
					<button string="Verify" name="verify_farmer" type="object" class="oe_highlight" confirm="Are you sure you want to Verify this Farmer?" invisible="farmer_stage != 'draft' or active == False or not is_farmer" groups="agrios.group_agrios_manager"/>

					<button string="Order Inputs" name="action_create_agrios_so" type="object" class="oe_highlight" invisible="not can_order_inputs or not is_farmer" groups="sales_team.group_sale_salesman"/>
					<button string="Order Inputs" name="action_create_agrios_so" type="object" invisible="not can_order_inputs_confirm or not is_farmer" groups="sales_team.group_sale_salesman" confirm="All active farmer contracts are not at the input stage, confirm that you still would like to order inputs?"/>

					<button string="Offtake" name="action_create_agrios_po" type="object" class="oe_highlight" invisible="not can_register_offtakes or not is_farmer" groups="purchase.group_purchase_user"/>
					<button string="Offtake" name="action_create_agrios_po" type="object" invisible="not can_register_offtakes_confirm or not is_farmer" groups="purchase.group_purchase_user" confirm="All active farmer contracts are not at the harvest stage, confirm that you still would like to register an off-take?"/>

					<button string="Create Farm" name="action_create_farm" type="object" invisible="not is_farmer" class="oe_highlight" groups="agrios.group_plot_management"/>

					<field name="farmer_stage"   invisible="not is_farmer" clickable="False" widget="statusbar"/>
				</header>
			</xpath>
			<xpath expr="//div[hasclass('oe_title')]/h1//field" position="before">
				<span invisible="farmer_ref == '/' or not is_farmer">
								[<field name="farmer_ref" class="oe_inline" help="Farmer reference"/>]
							</span>

			</xpath>

		</field>
	</record>
	<record id="view_farmer_form" model="ir.ui.view">
		<field name="name">view.farmer.form</field>
		<field name="model">res.partner</field>
		<field name="arch" type="xml">
			<form>
				<field name="count_certifications" invisible="1"/>
				<field name="certified" invisible="1"/>
				<field name="active" invisible="1"/>
				<field name="currency_id" invisible="1"/>
				<field name="farmer_requires_contract" invisible="1"/>
				<field name="can_order_inputs" invisible="1"/>
				<field name="can_order_inputs_confirm" invisible="1"/>
				<field name="can_register_offtakes" invisible="1"/>
				<field name="can_register_offtakes_confirm" invisible="1"/>
				<field name="has_expired_contract" invisible="1" groups="agrios.group_farmer_contract"/>
				<field name="plot_ids" invisible="1"/>
				<field name="loc_area_max_level" invisible="1"/>

				<header>
					<button string="Verify" name="verify_farmer" type="object" class="oe_highlight" confirm="Are you sure you want to Verify this Farmer?" invisible="farmer_stage != 'draft' or active == False" groups="agrios.group_agrios_manager"/>

					<button string="Order Inputs" name="action_create_agrios_so" type="object" class="oe_highlight" invisible="not can_order_inputs" groups="sales_team.group_sale_salesman"/>
					<button string="Order Inputs" name="action_create_agrios_so" type="object" invisible="not can_order_inputs_confirm" groups="sales_team.group_sale_salesman" confirm="All active farmer contracts are not at the input stage, confirm that you still would like to order inputs?"/>

					<button string="Offtake" name="action_create_agrios_po" type="object" class="oe_highlight" invisible="not can_register_offtakes" groups="purchase.group_purchase_user"/>
					<button string="Offtake" name="action_create_agrios_po" type="object" invisible="not can_register_offtakes_confirm" groups="purchase.group_purchase_user" confirm="All active farmer contracts are not at the harvest stage, confirm that you still would like to register an off-take?"/>

					<button string="Create Farm" name="action_create_farm" type="object" class="oe_highlight" groups="agrios.group_plot_management"/>

					<field name="farmer_stage" clickable="False" widget="statusbar"/>
				</header>
				<sheet>
					<widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
					<widget name="web_ribbon" title="Expired Contract" bg_color="text-bg-warning" invisible="not has_expired_contract" groups="agrios.group_farmer_contract"/>

					<div class="oe_button_box" name="button_box">
						<span class="fa-stack fa-3x oe_avatar" invisible="not count_certifications">
						</span>
						<button name="action_view_interactions" type="object" icon="fa-list-alt" string="Interactions" class="oe_stat_button" groups="agrios.group_farmers_interactions">
							<field name="interactions_count" widget="statinfo" />
						</button>
						<button class="oe_stat_button" name="action_view_farmer_contracts" type="object" icon="fa-file-text" invisible="farmer_stage != 'verified'" groups="agrios.group_farmer_contract">
							<field name="count_farmer_contracts" string="Contracts" widget="statinfo"/>
						</button>
						<button class="oe_stat_button" name="action_view_agrios_sale_orders" type="object" icon="fa-shopping-cart" invisible="farmer_stage != 'verified'" groups="sales_team.group_sale_salesman">
							<field name="count_input_sales" string="Input Orders" widget="statinfo"/>
						</button>
						<button class="oe_stat_button" name="action_view_agrios_purchase_orders" type="object" icon="fa-credit-card" invisible="farmer_stage != 'verified'" groups="purchase.group_purchase_user">
							<field string="Off-takes" name="count_harvest_offtakes" widget="statinfo"/>
						</button>
						<button type="object" class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_partner_invoices" context="{'default_partner_id': id}" invisible="farmer_stage == 'draft'" groups="account.group_account_invoice,account.group_account_readonly">
							<div class="o_form_field o_stat_info">
								<span class="o_stat_value">
									<field name="total_invoiced" widget="monetary" options="{'currency_field': 'currency_id'}"/>
								</span>
								<span class="o_stat_text">Invoiced</span>
							</div>
						</button>
					</div>

					<field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': True, 'preview_image': 'avatar_128'}"/>

					<div class="oe_title">
						<h1>
							<span invisible="farmer_ref == '/'">
								[<field name="farmer_ref" class="oe_inline" help="Farmer reference"/>]
							</span>
							<field name="name" placeholder="Farmer Name" required="1" class="oe_inline"/>
						</h1>
					</div>
					<group>
						<group string="Main Details">
							<field name="gender"/>
							<field name="birthday"/>
							<field name="age" invisible="not birthday"/>
							<field name="phone" widget="phone"/>
							<field name="id_type_id"/>
							<field name="farmer_id_number"/>
						</group>
						<group string="Address Details">
							<field name="street"/>
							<field name="city"/>
							<field name="zip"/>
							<field name="country_id"/>
						</group>
						<group string="Location Hierarchy">
							<field name="farmer_group_id"/>

							<td class="o_td_label" style="font-weight: 500;"  invisible="loc_area_max_level &lt; 1">
								<field name="loc_area_1_label"/>
							</td>
							<field name="loc_area_1_id" nolabel="1"  invisible="loc_area_max_level &lt; 1" domain="[('country_id','=',country_id),('parent_id','=?',loc_area_2_id)]"/>

							<td class="o_td_label" style="font-weight: 500;" invisible="loc_area_max_level &lt; 2">
								<field name="loc_area_2_label"/>
							</td>
							<field name="loc_area_2_id" nolabel="1" invisible="loc_area_max_level &lt; 2" domain="[('country_id','=',country_id),('parent_id','=?',loc_area_3_id)]"/>

							<td class="o_td_label" style="font-weight: 500;" invisible="loc_area_max_level &lt; 3">
								<field name="loc_area_3_label"/>
							</td>
							<field name="loc_area_3_id" nolabel="1" invisible="loc_area_max_level &lt; 3" domain="[('country_id','=',country_id),('parent_id','=?',loc_area_4_id)]"/>

							<td class="o_td_label" style="font-weight: 500;" invisible="loc_area_max_level &lt; 4">
								<field name="loc_area_4_label"/>
							</td>
							<field name="loc_area_4_id" nolabel="1" invisible="loc_area_max_level &lt; 4" domain="[('country_id','=',country_id),('parent_id','=?',loc_area_5_id)]"/>

							<td class="o_td_label" style="font-weight: 500;" invisible="loc_area_max_level &lt; 5">
								<field name="loc_area_5_label"/>
							</td>
							<field name="loc_area_5_id" nolabel="1" invisible="loc_area_max_level &lt; 5" domain="[('country_id','=',country_id),('parent_id','=?',loc_area_6_id)]"/>

							<td class="o_td_label" style="font-weight: 500;" invisible="loc_area_max_level &lt; 6">
								<field name="loc_area_6_label"/>
							</td>
							<field name="loc_area_6_id" nolabel="1" invisible="loc_area_max_level &lt; 6" domain="[('country_id','=',country_id)]"/>
						</group>
						<group string="Other Details">
							<field name="manager_id" invisible="1"/>
							<field name="user_id"/>
						</group>
					</group>
					<notebook>
						<page name="farm_detail" string="Farm Details">
							<group>
								<group>
									<label for="own_acreage" string="Own Plot Acreage"/>
									<div class="o_row mw-50">
										<field name="own_acreage" readonly="plot_ids" class="oe_inline o_hr_narrow_field" nolabel="1"/>
										<div class="mb-3">
											<field name="land_area_uom" readonly="1" options="{'no_open': True}"/>
										</div>
									</div>
									<label for="leased_acreage" string="Leased Plot Acreage"/>
									<div class="o_row mw-50">
										<field name="leased_acreage" readonly="plot_ids" class="oe_inline o_hr_narrow_field" nolabel="1"/>
										<div class="mb-3">
											<field name="land_area_uom" readonly="1" options="{'no_open': True}"/>
										</div>
									</div>
									<label for="total_acreage"/>
									<div class="o_row mw-50">
										<field name="total_acreage" readonly="1" force_save="1" class="oe_inline o_hr_narrow_field" nolabel="1"/>
										<div class="mb-3">
											<field name="land_area_uom" readonly="1" options="{'no_open': True}"/>
										</div>
									</div>
								</group>
								<group>
									<label for="total_contracted_acreage" groups="agrios.group_farmer_contract"/>
									<div class="o_row mw-50" groups="agrios.group_farmer_contract">
										<field name="total_contracted_acreage" class="oe_inline o_hr_narrow_field" nolabel="1"/>
										<div class="mb-3">
											<field name="land_area_uom" readonly="1" options="{'no_open': True}"/>
										</div>
									</div>
									<label for="non_contracted_acreage" groups="agrios.group_farmer_contract"/>
									<div class="o_row mw-50" groups="agrios.group_farmer_contract">
										<field name="non_contracted_acreage" class="oe_inline o_hr_narrow_field" nolabel="1"/>
										<div class="mb-3">
											<field name="land_area_uom" readonly="1" options="{'no_open': True}"/>
										</div>
									</div>
									<field name="crop_product_ids" widget="many2many_tags" options="{'no_create': True}"/>
									<field name="partner_latitude" string="Farm Latitude" groups="!agrios.group_plot_management"/>
									<field name="partner_longitude" string="Farm Longitude" groups="!agrios.group_plot_management"/>
								</group>
							</group>
							<group string="Farmer Land Plots" groups="agrios.group_plot_management">
								<field name="plot_ids" context="{'plot_partner_invisible': True}" nolabel="1" colspan="2">
									<list create="false">
						                <field name="name"/>
						                <field name="is_owner" optional="show"/>
						                <field name="loc_area_1_id" optional="hide"/>
						                <field name="loc_area_2_id" optional="hide"/>
						                <field name="loc_area_3_id" optional="hide"/>
						                <field name="plot_size" sum="Total" optional="show"/>
						                <field name="plot_condition" optional="show"/>
						                <field name="gshape_description" optional="hide"/>
									</list>
								</field>
							</group>
						</page>
						<page name="contract" string="Contracts" invisible="farmer_stage != 'verified'" groups="agrios.group_farmer_contract">
							<group>
								<field name="farmer_requires_contract" groups="agrios.group_agrios_manager"/>
							</group>
							<field name="farmer_contract_ids" readonly="True">
								<list decoration-muted="contract_stage=='closed'" decoration-danger="contract_stage=='cancelled' or expired_contract">
									<field name="name"/>
									<field name="season_id"/>
									<field name="contracted_crop_id"/>
									<field name="contract_acreage" sum="Total Contracted Acreage" optional="show"/>
									<field name="total_inputs_cost" sum="Total Inputs Cost" optional="show"/>
									<field name="contract_stage" optional="show"/>
									<field name="harvest_state" optional="show"/>
									<field name="expired_contract" invisible="contract_stage != 'open'" optional="show"/>
									<field name="currency_id" column_invisible="1"/>
								</list>
							</field>
						</page>
						<page name="certification" string="Certifications" invisible="farmer_stage != 'verified'" groups="agrios.group_farmers_certifications">
							<field name="certification_ids">
								<list create="false" decoration-info="style=='info'" decoration-muted="style=='muted'" decoration-success="style=='success'" decoration-warning="style=='warning'" decoration-danger="style=='danger'">
									<field name="certification_type_id"/>
									<field name="cert_serial_num" optional="show"/>
									<field name="cert_start_date"/>
									<field name="cert_end_date"/>
									<field name="origin" optional="show"/>
									<field name="final_score" avg="Average Score" optional="show"/>
									<field name="state"/>
									<field name="style" column_invisible="1"/>
								</list>
							</field>
						</page>
						<page name="training" string="Trainings Attended/Scheduled" invisible="farmer_stage != 'verified'" groups="agrios.group_farmers_training">
							<field name="training_ids" readonly="True"/>
						</page>
						<page name="additional_info" string="Additional Farmer Info">
							<group>
								<group string="Farmer Extra Details">
									<field name="family_size"/>
									<field name="highest_education_id"/>
									<field name="country_id"/>
								</group>
								<group string="Next Of Kin">
									<field name="next_of_kin" placeholder="NOK Full Name"/>
									<field name="nok_id"/>
									<field name="nok_phone" widget="phone"/>
								</group>
							</group>
							<group string="Extra Notes">
								<field name="comment" nolabel="1" colspan="2" placeholder="Extra internal information about the farmer..."/>
							</group>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>
</odoo>