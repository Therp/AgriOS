<odoo>
    <record id="view_highest_education_list" model="ir.ui.view">
        <field name="name">res.highest.education.list</field>
        <field name="model">res.highest.education</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_highest_education_form" model="ir.ui.view">
        <field name="name">res.highest.education.form</field>
        <field name="model">res.highest.education</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_highest_education" model="ir.actions.act_window">
        <field name="name">Highest Education</field>
        <field name="res_model">res.highest.education</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
