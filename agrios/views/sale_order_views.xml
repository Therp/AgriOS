<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.inherited.oms.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
        	<xpath expr="/form" position="inside">
        		<field name="verified_partner_farmer" invisible="1"/>
        		<field name="farmer_requires_contract" invisible="1"/>
        	</xpath>
            <xpath expr="//field[@name = 'partner_shipping_id']" position="after">
                <field name="farmer_contract_id" readonly="state == 'sale' and locked" invisible="not verified_partner_farmer" required="verified_partner_farmer and farmer_requires_contract" options="{'no_create': True}" context="{'verify_agrios_sale': company_id}" groups="agrios.group_farmer_contract"/>
            	<field name="payment_in_kind" readonly="state == 'sale' and locked" groups="agrios.group_payments_in_kind"/>
            </xpath>
        </field>
    </record>

	<record id="agrios_input_orders_action" model="ir.actions.act_window">
        <field name="name">Input Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="context">{}</field>
        <field name="domain">[('partner_id.is_farmer','=',True)]</field>
    </record>
    <record id="agrios_input_orders_action_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sale.view_order_tree"/>
        <field name="act_window_id" ref="agrios_input_orders_action"/>
    </record>
    <record id="agrios_input_orders_action_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="sale.view_sale_order_kanban"/>
        <field name="act_window_id" ref="agrios_input_orders_action"/>
    </record>
    <record id="agrios_input_orders_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale.view_order_form"/>
        <field name="act_window_id" ref="agrios_input_orders_action"/>
    </record>
    <record id="agrios_input_orders_action_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="sale.view_sale_order_calendar"/>
        <field name="act_window_id" ref="agrios_input_orders_action"/>
    </record>
    <record id="agrios_input_orders_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="sale.view_sale_order_pivot"/>
        <field name="act_window_id" ref="agrios_input_orders_action"/>
    </record>
    <record id="agrios_input_orders_action_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="6"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="sale.view_sale_order_graph"/>
        <field name="act_window_id" ref="agrios_input_orders_action"/>
    </record>

</odoo>
