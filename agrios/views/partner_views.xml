<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_certified_farmers_form" model="ir.actions.act_window.view">
            <field name="view_id" ref="view_farmer_partner_form"/>
            <field name="act_window_id" ref="action_certified_farmers"/>
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
    </record>

    <record id="action_active_season_farmers" model="ir.actions.act_window">
            <field name="name">Active Farmers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_farmer_search_filter"/>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="domain">[('is_farmer','=',True),('farmer_stage','=','verified')]</field>
            <field name="help" type="html">
                    <p class="o_view_nocontent_smiling_face">
                            There are no Active Farmers
                    </p>
            </field>
    </record>
    <record id="action_active_farmers_tree" model="ir.actions.act_window.view">
            <field name="view_id" ref="view_farmer_tree"/>
            <field name="act_window_id" ref="action_active_season_farmers"/>
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
    </record>

    <record id="action_verify_farmer" model="ir.actions.server">
            <field name="name">Verify Farmer</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="binding_model_id" ref="model_res_partner"/>
            <field name="groups_id" eval="[(6, 0, [ref('agrios.group_agrios_manager')])]"/>
            <field name="state">code</field>
            <field name="code">records.verify_farmer()</field>
    </record>

    <record id="action_trainers" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context" eval="{'default_category_id': [(6, 0, [ref('agrios.internal_trainer')])], 'default_is_farmer_trainer': True}" />
        <field name="domain">[('is_farmer_trainer','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Trainer
            </p>
            <p>
                Odoo helps you easily track all Trainers
            </p>
        </field>
    </record>

</odoo>
