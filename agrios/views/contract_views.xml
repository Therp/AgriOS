<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	
	<record id="view_offtake_agreement_search" model="ir.ui.view">
		<field name="name">view.offtake.agreement.search</field>
		<field name="model">offtake.agreement</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<field name="outgrower_id"/>
				<separator/>
				<filter string="Draft Contracts" name="filter_draft" domain="[('contract_stage','=','draft')]"/>
				<filter string="Open Contracts" name="filter_open" domain="[('contract_stage','=','open')]"/>
				<filter string="Closed Contracts" name="filter_closed" domain="[('contract_stage','=','closed')]"/>
				<filter string="Cancelled Contracts" name="filter_cancelled" domain="[('contract_stage','=','cancelled')]"/>
				<separator/>
				<filter string="Expired Contracts" name="filter_expired" domain="[('expired_contract','=',True)]"/>
				<group>
					<filter string="Stage" name="groupby_contract_stage" context="{'group_by': 'contract_stage'}"/>
					<filter string="Outgrower" name="groupby_outgrower_id" context="{'group_by': 'outgrower_id'}"/>
					<filter string="Season" name="groupby_season" context="{'group_by': 'season_id'}"/>
					<filter string="Crop" name="groupby_crop" context="{'group_by': 'contracted_crop_id'}"/>
				</group>
			</search>
		</field>
	</record>
	
	<record id="view_offtake_agreement_tree" model="ir.ui.view">
		<field name="name">view.offtake.agreement.tree</field>
		<field name="model">offtake.agreement</field>
		<field name="arch" type="xml">
			<list sample="1" decoration-muted="contract_stage=='closed'" decoration-danger="contract_stage=='cancelled' or expired_contract">
				<field name="name" column_invisible="bool(context.get('hide_contract_reference'))"/>
				<field name="outgrower_id" context="{'form_view_ref': 'agrios.view_outgrower_form'}"/>
				<field name="season_id" optional="show"/>
				<field name="contracted_crop_id" optional="show"/>
				<field name="contracted_farm_acreage" sum="Total Contracted Farm" optional="show"/>
				<field name="farm_inputs_cost" sum="Total Farm Loan" optional="show"/>
				<field name="contract_stage" optional="show"/>
				<field name="harvest_state" optional="show"/>
				<field name="expired_contract" invisible="contract_stage != 'open'" optional="show" column_invisible="bool(context.get('hide_expired_contract'))"/>
				<field name="currency_id" column_invisible="1"/>
			</list>
		</field>
	</record>
	
	<record id="view_offtake_agreement_no_create_edit_tree" model="ir.ui.view">
		<field name="name">view.offtake.agreement.no.create.tree</field>
		<field name="model">offtake.agreement</field>
		<field name="inherit_id" ref="agrios.view_offtake_agreement_tree"/>
		<field name="mode">primary</field>
		<field name="priority" eval ="20"/>
		<field name="arch" type="xml">
			<xpath expr="/list" position="attributes">
				<attribute name="create">false</attribute>
				<attribute name="edit">false</attribute>
			</xpath>
		</field>
	</record>
	
	<record id="view_offtake_agreement_form" model="ir.ui.view">
		<field name="name">view.offtake.agreement.form</field>
		<field name="model">offtake.agreement</field>
		<field name="arch" type="xml">
			<form>
				<field name="ready_for_harvest" invisible="1"/>
				<field name="balance_qty" invisible="1"/>
				<field name="same_unutilized_contracted" invisible="1"/>
				<field name="active_contract" invisible="1"/>
				<field name="expired_contract" invisible="1"/>
				<field name="company_id" invisible="1"/>
				<field name="can_order_inputs" invisible="1"/>
				<field name="can_regist_offtakes" invisible="1"/>
				<field name="farmer_harvest_crop_ids" invisible="1"/>
				<field name="available_seed_ids" invisible="1" groups="agrios.group_seed_varieties"/>
				
				<header>
					<button name="confirm_offtake_agreement" string="Confirm" type="object" class="oe_highlight" confirm="Are you sure you want to confirm this contract? The value set on the 'Contracted Farm' is lower than 'Unutilized Farm' value. Please, make sure this should be in fact the case before proceeding, this action can't be reversed. Furthermore, for the same reason, also ensure that all the farms of the farmer have been mapped." invisible="contract_stage != 'draft' or same_unutilized_contracted == True" groups="agrios.group_agrios_user"/>
					<button name="confirm_offtake_agreement" string="Confirm" type="object" class="oe_highlight" confirm="Are you sure you want to confirm this contract? Please ensure that all the farms of the farmer have been mapped and that the 'Contracted Farm' value is correct before proceeding because this action can't be reversed." invisible="contract_stage != 'draft' or same_unutilized_contracted == False" groups="agrios.group_agrios_user"/> 
					
					<button name="btn_set_contracted_mapped_qty" string="Set to Mapped Quantities" type="object" invisible="contract_stage != 'draft' or same_unutilized_contracted == True" groups="agrios.group_agrios_user"/>
					
					<button name="action_create_agrios_oa_sale_orders" string="Order Inputs" type="object" class="oe_highlight" invisible="not can_order_inputs or ready_for_harvest" groups="sales_team.group_sale_salesman"/>
					<button name="action_create_agrios_oa_sale_orders" string="Order Inputs" type="object" invisible="not can_order_inputs or not ready_for_harvest" confirm="The contract is at the harverst stage, confirm that you still would like to order inputs from it?" groups="sales_team.group_sale_salesman"/>
					
					<button name="action_create_agrios_oa_purchase_order" string="Off-take" type="object" class="oe_highlight" invisible="not can_regist_offtakes or not ready_for_harvest" groups="purchase.group_purchase_user"/>
					<button name="action_create_agrios_oa_purchase_order" string="Off-take" type="object" invisible="not can_regist_offtakes or ready_for_harvest" confirm="The contract is still at the input stage, confirm that you still would like to register an off-take from it?" groups="purchase.group_purchase_user"/>
					
					<button name="set_ready_for_harvest" string="Mark Ready For Harvest" type="object" confirm="Are you sure you want to start buying off-take? You won't be able to order more inputs after!" invisible="contract_stage != 'open' or ready_for_harvest != False" groups="agrios.group_agrios_user"/>
					
					<button name="close_offtake_agreement" string="Close" type="object" confirm="Are you sure you want to close this contract which hasn't expired yet?" invisible="contract_stage != 'open' or expired_contract" groups="agrios.group_agrios_user"/>
					<button name="close_offtake_agreement" string="Close" type="object" class="oe_highlight" invisible="contract_stage != 'open' or not expired_contract" groups="agrios.group_agrios_user"/>
					
					<button name="btn_cancel_contract" string="Cancel" type="object" confirm="Are you sure you want to cancel this Contract?" invisible="contract_stage in ('closed', 'cancelled')" groups="agrios.group_agrios_user"/>
					
					<field name="contract_stage" clickable="false" widget="statusbar" statusbar_visible="draft,open,closed"/> 
				</header>
				<sheet>
                    <widget name="web_ribbon" title="Active" invisible="not active_contract"/>
					<widget name="web_ribbon" title="Expired" bg_color="text-bg-warning" invisible="not expired_contract"/>
					
					<div class="oe_button_box" name="button_box">
						<button class="oe_stat_button" name="action_agrios_oa_sale_orders" type="object" icon="fa-shopping-cart" groups="sales_team.group_sale_salesman">
							<field name="count_oa_input_sales" string="Input Orders" widget="statinfo"/>
						</button>
						<button class="oe_stat_button" name="action_agrios_oa_purchase_orders" type="object" icon="fa-credit-card" groups="purchase.group_purchase_user">
							<field name="count_oa_purchases" string="Off-takes" widget="statinfo"/>
						</button>
					</div>
					<div class="oe_title" invisible="name == '/'">
						<span class="o_form_label">Contract Reference</span>
						<h1><field name="name"/></h1>
					</div>
					<group string="Contract Details">
						<group>
							<field name="outgrower_id" options="{'limit': 1, 'no_create': True, 'no_create_edit': True}" readonly="contract_stage != 'draft'" context="{'form_view_ref': 'agrios.view_outgrower_form'}"/>
							<field name="og_doc_id"/>
							<field name="unutilized_acreage"/>
							<field name="harvest_state" invisible="contract_stage != 'open'"/>
						</group>
						<group>
							<field name="season_id" options="{'no_create': True}" domain="[('status','=','open')]" readonly="contract_stage != 'draft'"/>
							<field name="season_start_date"/>
							<field name="season_end_date"/>
							<field name="company_id" readonly="contract_stage != 'draft'" options="{'no_open': True, 'no_create': True}" groups="base.group_multi_company"/>
						</group>
					</group>
					<group>
						<group string="Purchase Details">
							<field name="contracted_crop_id" options="{'no_create': True, 'no_create_edit': True}" readonly="contract_stage != 'draft'"/>
							<label for="contracted_farm_acreage"/>
							<div class="o_row mw-50">
								<field name="contracted_farm_acreage" class="oe_inline o_hr_narrow_field" nolabel="1" readonly="contract_stage != 'draft'" />
								<div class="mb-3">
									<field name="farm_uom" readonly="1" options="{'no_open': True}"/>
								</div>
							</div>
							<label for="offtake_qty"/>
							<div class="o_row mw-50">
								<field name="offtake_qty" class="oe_inline o_hr_narrow_field" nolabel="1" readonly="contract_stage != 'draft'"/>
								<div class="mb-3"> KGs</div>
							</div>
							<label for="received_offtake_qty"/>
							<div class="o_row mw-50">
								<field name="received_offtake_qty" class="oe_inline o_hr_narrow_field" nolabel="1"/>
								<div class="mb-3"> KGs</div>
							</div>
							<field name="currency_id" invisible="1"/>
							<field name="offtake_unit_price" force_save="1" readonly="contract_stage != 'draft'"/>
							<field name="total_offtake_cost"/>
						</group>
						<group string="Input Details">
							<field name="seed_variety_id" options="{'no_create': True, 'no_create_edit': True}" domain="[('id','in',available_seed_ids)]" readonly="contract_stage != 'draft'" required="contract_stage == 'draft' and available_seed_ids" groups="agrios.group_seed_varieties"/>
							<field name="farm_inputs_cost"/>
						</group>
					</group>
					<notebook>
						<page name="farm_input" string="Farm Inputs (Sales)">
							<field name="oa_input_ids" readonly="True" options="{'no_open':True}">
								<list>
									<field name="order_id"/>
									<field name="name"/>
									<field name="product_uom_qty"/>
									<field name="qty_delivered"/>
									<field name="qty_invoiced"/>
									<field name="product_uom" string="UoM" optional="show"/>
									<field name="price_unit"/>
									<field name="price_subtotal" sum="Total Net Amount" optional="show"/>
									<field name="price_tax" sum="Total Tax Amount" optional="hide"/>
									<field name="price_total" sum="Total Gross Amount" optional="show"/>
									<field name="currency_id" column_invisible="True"/>
								</list>
							</field>
						</page>
						<page name="purchase" string="Off-Takes (Purchases)">
							<field name="oa_offtake_ids" readonly="1" options="{'no_open':True}">
								<list>
									<field name="order_id"/>
									<field name="name"/>
									<field name="product_qty"/>
									<field name="qty_received"/>
									<field name="qty_invoiced"/>
									<field name="product_uom" string="UoM" optional="show"/>
									<field name="price_unit"/>
									<field name="price_subtotal" sum="Total Net Amount" optional="show"/>
									<field name="price_tax" sum="Total Tax Amount" optional="hide"/>
									<field name="price_total" sum="Total Gross Amount" optional="hide"/>
									<field name="date_planned" string="Date Received" optional="hide"/>
									<field name="currency_id" column_invisible="True"/>
								</list>
							</field>
						</page>
						<page name="interaction" string="Interactions" groups="agrios.group_farmers_interactions">
							<field name="interaction_ids" readonly="contract_stage != 'open'" context="{'default_outgrower_id': outgrower_id}">
								<list delete="false">
									<field name="interaction_date"/>
									<field name="interaction_type"/>
									<field name="name"/>
								</list>
								<form>
									<sheet>
										<group>
											<group>
												<field name="interaction_type"/>
												<field name="interaction_date"/>
												<field name="name"/>
											</group>
											<group></group>
										</group>
										<label for="notes"/>
										<field name="notes" widget="html"/>
									</sheet>
								</form>
							</field>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>
	
	<record id="action_offtake_agreements" model="ir.actions.act_window">
		<field name="name">Offtake Agreement Contracts</field>
		<field name="res_model">offtake.agreement</field>
		<field name="view_mode">list,form</field>
		<field name="context">{"search_default_filter_open": 1}</field>
		<field name="domain">[]</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Create the first Offtake Agreement
			</p>
			<p>
				Odoo helps you easily track all activities related to an Offtake Agreement
			</p>
		</field>
	</record>
	
	<record id="multiple_confirm_draft_contracts_action" model="ir.actions.act_window">
		<field name="name">Confirm Draft Contracts</field>
		<field name="res_model">multiple.confirm.draft.contracts.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="model_offtake_agreement"/>
		<field name="binding_view_types">list</field>
	</record>
	
	<record id="multiple_set_contracted_mapped_qty_action" model="ir.actions.act_window">
		<field name="name">Set to Mapped Quantities</field>
		<field name="res_model">multiple.set.contracted.mapped.qty.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="model_offtake_agreement"/>
		<field name="binding_view_types">list</field>
	</record>
	
</odoo>