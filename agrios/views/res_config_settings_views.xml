<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	
	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">view.oms.res.config.settings.form</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app data-string="AgriOS" string="AgriOS" name="agrios">
					<block title="Operations" name="operations_setting_container">
						<setting id="offtake_agreements" help="Allows the management of offtake agreement contract with the farmers." company_dependent="1">
							<field name="group_offtake_agreement"/>
							<div class="content-group">
								<div invisible="not group_offtake_agreement">
									 <button name="%(agrios.action_offtake_agreements)d" icon="oi-arrow-right" type="action" string="Offtake Agreements" class="btn-link"/>
								</div>
								<div class="mt16" invisible="not group_offtake_agreement">
									<div>
										<field name="agrios_default_contract_needed" class="w-auto"/>
                                    	<label for="agrios_default_contract_needed"/>
                                    	<span class="o_doc_link" style="cursor: help; margin-left: -7px;" title="If selected, outgrowers will require, by default, a valid contract to sell inputs or to buy off-takes from them. If unselected, no contract, by default, is needed. Individual cases can be changed on each outgrower record form page."/>
									</div>
									<div>
										<field name="agrios_close_expired_contracts" class="w-auto"/>
                                    	<label for="agrios_close_expired_contracts"/>
                                    	<span class="o_doc_link" style="cursor: help; margin-left: -7px;" title="If selected, expired contracts will be automatically closed by Odoo. If not, expired contracts will need to be closed manually."/>
									</div>
									<div>
										<field name="agrios_allow_operations_out_of_phase" class="w-auto"/>
                                    	<label for="agrios_allow_operations_out_of_phase"/>
                                    	<span class="o_doc_link" style="cursor: help; margin-left: -7px;" title="If selected, input sales can be made on contracts in the harvestable phase and off-take purchases can be made on contracts on the input phase. If not, input sales can only be done on contracts on the input phase and off-take purchases can only be done on contracts on the harvestable phase."/>
									</div>
								</div>
						  	</div>
					 	</setting>
					 	<setting id="seed_varieties" help="Allows the management of seeds varieties to product a harvestable product.">
							<field name="group_seed_varieties"/>
						</setting>
						<setting id="farmers_training" help="Allows the management of farmers training.">
							<field name="group_farmers_training"/>
							<div class="content-group">
								<div invisible="not group_farmers_training">
									<button name="%(agrios.action_farmer_trainings)d" icon="oi-arrow-right" type="action" string="Farmer Trainings" class="btn-link"/>
								</div>
						  	</div>
						</setting>
						<setting id="farmers_interactions" help="Allows the management of interactions made with farmers (calls, visits, etc...).">
				  			<field name="group_farmers_interactions"/>
							<div class="content-group">
								<div invisible="not group_farmers_interactions">
									<button name="%(agrios.action_outgrower_interaction)d" icon="oi-arrow-right" type="action" string="Farmer Interactions" class="btn-link"/>
								</div>
							</div>
						</setting>
						<setting id="farmers_certifications" help="Allows the management of farmer certifications.">
							<field name="group_farmers_certifications"/>
							<div class="content-group">
								<div invisible="not group_farmers_certifications">
									<button name="%(agrios.action_farmer_certificates)d" icon="oi-arrow-right" type="action" string="Farmer Certifications" class="btn-link"/>
								</div>
							</div>
						</setting>
						<setting id="payments_in_kind" help="Allows payments in kind to be done to outgrowers input requests.">
							<field name="group_payments_in_kind"/>
							<div class="content-group">
								<div class="mt16" invisible="not group_payments_in_kind">
									<div>
										<field name="agrios_payment_in_kind_optional" class="w-auto"/>
                                    	<label for="agrios_payment_in_kind_optional"/>
                                    	<span class="o_doc_link" style="cursor: help; margin-left: -7px;" title="If selected, users will be able to decide if an off-take purchase will be paid or not by the outgrower 'payment in kind' inputs. If not selected, off-take purchases will always be paid (fully or partially) by any open 'payment in kind' input sales the outgrower has."/>
									</div>
								</div>
							</div>
						</setting>
					</block>
					
					<block title="Farm">
						<setting id="farm_uom" string="Land Size UoM" help="Set the unit of measure that the area of farms are measured.">
							<div class="content-group">
								<field name="farm_uom" options="{'no_create': True}" readonly="farm_uom == True" class="o_light_label"/>
							</div>
						</setting>
						<setting id="max_land_size" string="Max Land Size" help="Leave the value as 0.0 to allow any farm size to be set.">
							<div class="content-group">
								<field name="max_land_size" class="o_light_label"/>
							</div>
					 	</setting>
						<setting id="plots_management" string="Complex Plot Management" help="Allows the creation of plot records (which determine the total acreage of the Outgrower), the registration of trees planted, and the use several crops per plot of land">
							<field name="group_plot_management"/>
							<div class="content-group">
								<div class="mt16" invisible="not group_plot_management">
									<div>
										<field name="group_plot_maps" class="w-auto"/>
                                    	<label for="group_plot_maps"/>
                                    	<span class="o_doc_link" style="cursor: help; margin-left: -7px;" title="Allows farmer plots to be recorded on a map."/>
									</div>
								</div>
							</div>
						</setting>
					</block>
		  		</app>
		 	</xpath>
		</field>
	</record>
	
  	<record id="action_agrios_configuration_settings" model="ir.actions.act_window">
		<field name="name">Settings</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">res.config.settings</field>
		<field name="view_mode">form</field>
		<field name="target">inline</field>
		<field name="context">{'module': 'agrios', 'bin_size': False}</field>
  	</record>
	
</odoo>