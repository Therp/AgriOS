<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">

	<record id="module_category_agrios" model="ir.module.category">
		<field name="name">AgriOS</field>
		<field name="description">Ougrower Management Rights</field>
		<field name="sequence">10</field>
	</record>

	<record id="module_category_ai_agrios_inventory" model="ir.module.category">
		<field name="name">AgriOS Inventory</field>
		<field name="description">AgriOS Related Inventory Rights</field>
		<field name="sequence">40</field>
	</record>

	<record id="group_agrios_readonly" model="res.groups">
		<field name="name">Readonly</field>
		<field name="category_id" ref="module_category_agrios"/>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
	</record>

	<record id="group_agrios_user" model="res.groups">
		<field name="name">User</field>
		<field name="category_id" ref="module_category_agrios"/>
		<field name="implied_ids" eval="[(4, ref('group_agrios_readonly'))]"/>
	</record>

	<record id="group_agrios_tc" model="res.groups">
		<field name="name">Technical Coordinator</field>
		<field name="category_id" ref="module_category_agrios"/>
		<field name="implied_ids" eval="[(4, ref('group_agrios_user'))]"/>
	</record>

	<record id="group_agrios_manager" model="res.groups">
		<field name="name">Manager</field>
		<field name="category_id" ref="module_category_agrios"/>
		<field name="implied_ids" eval="[(4, ref('group_agrios_tc'))]"/>
	</record>

	<record id="group_agrios_admin" model="res.groups">
		<field name="name">Administrator</field>
		<field name="category_id" ref="module_category_agrios"/>
		<field name="implied_ids" eval="[(4, ref('group_agrios_manager'))]"/>
		<field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
	</record>

	<record id="group_sale_salesman_tc" model="res.groups">
		<field name="name">User: Technical Coordinator</field>
		<field name="category_id" ref="base.module_category_sales_sales"/>
		<field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
		<field name="comment">the user will have access to records of the Area Level 1 farmers he/she coordinates.</field>
	</record>

	<record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
		<field name="implied_ids" eval="[(6, 0, [ref('agrios.group_sale_salesman_tc')])]"/>
	</record>

	<record id="group_purchase_salesman_tc" model="res.groups">
		<field name="name">User: Technical Coordinator</field>
		<field name="category_id" ref="base.module_category_inventory_purchase"/>
		<field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
		<field name="comment">the user will have access to records of the Area Level 1 farmers he/she coordinates.</field>
	</record>

	<record id="purchase.group_purchase_manager" model="res.groups">
		<field name="implied_ids" eval="[(6, 0, [ref('agrios.group_purchase_salesman_tc')])]"/>
	</record>

	<record id="group_stock_salesman_tc" model="res.groups">
		<field name="name">User: Technical Coordinator</field>
		<field name="category_id" ref="module_category_ai_agrios_inventory"/>
		<field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
		<field name="comment">the user will have access to records of the Area Level 1 farmers he/she coordinates.</field>
	</record>

   	<record id="group_farmer_contract" model="res.groups">
		<field name="name">AgriOS - Manage Offtake Agreements</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_farmers_training" model="res.groups">
		<field name="name">AgriOS - Manage Farmers Training</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_farmers_interactions" model="res.groups">
		<field name="name">AgriOS - Manage Farmers Interactions</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_farmers_certifications" model="res.groups">
		<field name="name">AgriOS - Manage Farmers Certifications</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_seed_varieties" model="res.groups">
		<field name="name">AgriOS - Manage Seed Varieties</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_plot_management" model="res.groups">
		<field name="name">AgriOS - Plot Management</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_payments_in_kind" model="res.groups">
		<field name="name">AgriOS - Payments In Kind</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

	<record id="group_plot_maps" model="res.groups">
		<field name="name">AgriOS - Plot Maps</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>

</odoo>
