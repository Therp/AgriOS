		<field name="model_id" ref="stock.model_stock_picking"/>
		<field name="domain_force">[(1,'=',1)]</field>
		<field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
	</record>
	
	<record id="tc_res_partner_rule" model="ir.rule">
		<field name="name">Technical Coordinator Contact Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('id','in',user.responsible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('agrios.group_agrios_tc'))]"/>
	</record>
	<record id="manager_res_partner_rule" model="ir.rule">
		<field name="name">Manager Contact Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('id','not in',user.responsible_farmer_ids.ids)]</field>
		<field name="groups" eval="[(4, ref('agrios.group_agrios_manager'))]"/>
	</record>
	
	<record id="agrios_iu_res_partner_rule" model="ir.rule">
		<field name="name">Internal User AgriOS Partner Edit Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('is_farmer','=',False)]</field>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="perm_read" eval="False"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>
	<record id="agrios_user_res_partner_rule" model="ir.rule">
		<field name="name">AgriOS User Partner Edit Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('is_farmer','=',True), ('farmer_stage','=','draft')]</field>
		<field name="groups" eval="[(4, ref('agrios.group_agrios_user'))]"/>
		<field name="perm_read" eval="False"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>
	<record id="agrios_manager_res_partner_rule" model="ir.rule">
		<field name="name">AgriOS Manager Partner Edit Rule</field>
		<field name="model_id" ref="base.model_res_partner"/>
		<field name="domain_force">[('is_farmer','=',True), ('farmer_stage','=','verified')]</field>
		<field name="groups" eval="[(4, ref('agrios.group_agrios_manager'))]"/>
		<field name="perm_read" eval="False"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>
	
