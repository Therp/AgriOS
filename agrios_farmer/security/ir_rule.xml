<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="farmer_group_comp_rule" model="ir.rule">
        <field name="name">Farmer Group Company Rule</field>
        <field name="model_id" ref="model_farmer_group"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <!-- res.partner rules -->

    <record id="tc_res_partner_rule" model="ir.rule">
        <field name="name">Technical Coordinator Contact Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="manager_res_partner_rule" model="ir.rule">
        <field name="name">Manager Contact Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id','not in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
    </record>

    <record id="agrios_iu_res_partner_rule" model="ir.rule">
        <field name="name">Internal User AgriOS Partner Edit Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('is_farmer','=',False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="agrios_user_res_partner_rule" model="ir.rule">
        <field name="name">AgriOS User Partner Edit Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('is_farmer','=',True), ('farmer_stage','=','draft')]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="agrios_manager_res_partner_rule" model="ir.rule">
        <field name="name">AgriOS Manager Partner Edit Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('is_farmer','=',True), ('farmer_stage','=','verified')]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- farmer.group rules -->

    <record id="tc_farmer_group_rule" model="ir.rule">
        <field name="name">Technical Coordinator Farmer Group Rule</field>
        <field name="model_id" ref="agrios_farmer.model_farmer_group"/>
        <field name="domain_force">[('agrios_area_id.manager_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="manager_farmer_group_rule" model="ir.rule">
        <field name="name">Manager Farmer Group Rule</field>
        <field name="model_id" ref="agrios_farmer.model_farmer_group"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
    </record>

    <!-- farmer.interaction rules -->

    <record id="tc_farmer_interaction_rule" model="ir.rule">
        <field name="name">Technical Coordinator Farmer Interaction Rule</field>
        <field name="model_id" ref="agrios_farmer.model_farmer_interaction"/>
        <field name="domain_force">[('farmer_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="manager_farmer_interaction_rule" model="ir.rule">
        <field name="name">Manager Farmer Interaction Rule</field>
        <field name="model_id" ref="agrios_farmer.model_farmer_interaction"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
    </record>

</odoo>
