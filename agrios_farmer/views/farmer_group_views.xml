<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Farmer Groups -->

    <record id="view_farmer_group_tree" model="ir.ui.view">
        <field name="name">view.farmer.group.tree</field>
        <field name="model">farmer.group</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name"/>
                <field name="chairperson_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_farmer_group_form" model="ir.ui.view">
        <field name="name">view.farmer.group.form</field>
        <field name="model">farmer.group</field>
        <field name="arch" type="xml">
            <form>
                <field name="active" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <sheet>
                    <div class="oe_button_box" name="button_box"></div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active == True"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Group Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chairperson_id" options="{'no_create': True}"/>
                            <field name="group_sec_id" options="{'no_create': True}"/>
                            <field name="group_treasurer_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <td
                                class="o_td_label"
                                style="font-weight: 500;"
                                invisible="not agrios_area_allowed"
                            >
                                <field name="agrios_area_label"/>
                            </td>
                            <field
                                name="agrios_area_id"
                                nolabel="1"
                                options="{'no_open': True,'no_create': True}"
                                domain="[('country_id','=',country_id)]"
                                invisible="not agrios_area_allowed"
                            />
                            <field
                                name="country_id"
                                options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                            />
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Farmers">
                            <field name="member_ids" readonly="True"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_farmer_groups" model="ir.actions.act_window">
        <field name="name">Farmer Groups</field>
        <field name="res_model">farmer.group</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Farmers' Group
            </p>
            <p>
                Odoo helps you easily track all activities related to a Farmers' Group
            </p>
        </field>
    </record>
</odoo>
