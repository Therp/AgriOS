<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="corrective_action_tree" model="ir.ui.view">
        <field name="name">corrective.action.tree</field>
        <field name="model">corrective.action</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="code" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="corrective_action_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">corrective.action</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first certification corrective action
            </p>
        </field>
    </record>

</odoo>
