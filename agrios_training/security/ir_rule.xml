<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="tc_certified_farmer_rule" model="ir.rule">
        <field name="name">Technical Coordinator Farmer Certification Rule</field>
        <field name="model_id" ref="agrios_training.model_farmer_certification"/>
        <field name="domain_force">[('farmer_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="manager_certified_farmer_rule" model="ir.rule">
        <field name="name">Manager Farmer Certification Rule</field>
        <field name="model_id" ref="agrios_training.model_farmer_certification"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
    </record>

    <record id="tc_farmer_training_rule" model="ir.rule">
        <field name="name">Technical Coordinator Farmer Training Rule</field>
        <field name="model_id" ref="agrios_training.model_farmer_training"/>
        <field name="domain_force">[('agrios_area_id','in',user.partner_id.managed_area_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="manager_farmer_training_rule" model="ir.rule">
        <field name="name">Manager Farmer Training Rule</field>
        <field name="model_id" ref="agrios_training.model_farmer_training"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
    </record>

</odoo>
