<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_season_tree" model="ir.ui.view">
        <field name="name">view.season.tree</field>
        <field name="model">season</field>
        <field name="arch" type="xml">
            <list
                sample="1"
                decoration-danger="expired"
                decoration-success="status == 'open' and not expired"
                decoration-muted="status == 'lock' and not expired"
            >
                <field name="season"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
                <field name="expired" invisible="status not in ('open', 'lock')"/>
            </list>
        </field>
    </record>

    <record id="view_season_form" model="ir.ui.view">
        <field name="name">view.season.form</field>
        <field name="model">season</field>
        <field name="arch" type="xml">
            <form>
            	<field name="expired" invisible="True"/>
            	<field name="active" invisible="True"/>
                <header>
                    <button
                        name="start_registration"
                        string="Start Registration"
                        type="object"
                        class="oe_highlight"
                        confirm="Are you sure you want to Start Registration for this Season?"
                        invisible="status != 'draft'"
                    />
                    <button
                        name="lock_registration"
                        string="Lock Registration"
                        type="object"
                        class="oe_highlight"
                        confirm="Are you sure you want to Lock Registration?"
                        invisible="status != 'open'"
                    />
                    <button
                        name="reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="oe_highlight"
                        confirm="Are you sure you want to Reset to Draft?"
                        invisible="status != 'lock'"
                    />
                    <button
                        name="close_season"
                        string="Close"
                        type="object"
                        class="oe_highlight"
                        confirm="Are you sure you want to Close this Season?"
                        invisible="status == 'closed'"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="draft,open,lock,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Expired" bg_color="bg-warning" invisible="not expired"/>
                    <div class="oe_title">
                        <h1>
                            <field name="season" placeholder="Season Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_seasons" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">season</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Season
            </p>
            <p>
                Odoo helps you easily track all activities related to a Season
            </p>
        </field>
    </record>

</odoo>
