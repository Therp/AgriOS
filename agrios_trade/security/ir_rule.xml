<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="tc_sale_order_rule" model="ir.rule">
        <field name="name">Technical Coordinator Sales Orders Rule</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('partner_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="tc_sale_order_line_rule" model="ir.rule">
        <field name="name">Technical Coordinator Order Lines</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.partner_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>

    <record id="tc_purchase_order_rule" model="ir.rule">
        <field name="name">Technical Coordinator Purchase Orders Rule</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('partner_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <record id="manager_purchase_order_rule" model="ir.rule">
        <field name="name">Manager Purchase Orders Rule</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <record id="tc_stock_picking_rule" model="ir.rule">
        <field name="name">Technical Coordinator Stock Picking Rule</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[('partner_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="manager_stock_picking_rule" model="ir.rule">
        <field name="name">Manager Stock Picking Rule</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="tc_farmer_contract_rule" model="ir.rule">
        <field name="name">Technical Coordinator Offtake Agreement Rule</field>
        <field name="model_id" ref="model_farmer_contract"/>
        <field name="domain_force">[('farmer_id','in',user.partner_id.responsible_farmer_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_tc'))]"/>
    </record>
    <record id="manager_farmer_contract_rule" model="ir.rule">
        <field name="name">Manager Offtake Agreement Rule</field>
        <field name="model_id" ref="model_farmer_contract"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('agrios_farmer.group_agrios_manager'))]"/>
    </record>

    <record id="farmer_contract_comp_rule" model="ir.rule">
        <field name="name">Offtake Agreement multi-company</field>
        <field name="model_id" ref="model_farmer_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
