<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
	<record id="cloudpepper_default_module_view_form" model="ir.ui.view">
		<field name="name">cloudpepper.default.module.view.form</field>
		<field name="model">cloudpepper.default.module</field>
		<field name="arch" type="xml">
			<form string="Cloudpepper.default.module">
				<sheet>
					<group>
						<field name="repo"/>
						<field name="branch"/>
						<field name="module_name"/>
						<field name="active"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>
	
	<record id="cloudpepper_default_module_view_list" model="ir.ui.view">
		<field name="name">cloudpepper.default.module.view.list</field>
		<field name="model">cloudpepper.default.module</field>
		<field name="arch" type="xml">
			<list string="Cloudpepper.default.module">
				<field name="repo"/>
				<field name="branch"/>
				<field name="module_name"/>
				<field name="active"/>
			</list>
		</field>
	</record>
	
	<record id="cloudpepper_default_module_action" model="ir.actions.act_window">
		<field name="name">Default Module</field>
		<field name="res_model">cloudpepper.default.module</field>
		<field name="view_mode">list,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				Create your first Default Module!
			</p>
		</field>
	</record>
	
</odoo>