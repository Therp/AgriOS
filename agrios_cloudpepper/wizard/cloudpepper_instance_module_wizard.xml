<odoo>
	
	<record id="view_cloudpepper_instance_module_wizard_form" model="ir.ui.view">
		<field name="name">cloudpepper.instance.module.wizard.form</field>
		<field name="model">cloudpepper.instance.module.wizard</field>
		<field name="arch" type="xml">
			<form string="Add Module to Instance">
				<group>
					<field name="repo"/>
					<field name="branch"/>
					<field name="type"/>
					<field name="module_name"/>
				</group>
				<footer>
					<button string="Add Module" type="object" name="action_add_module" class="btn-primary"/>
					<button string="Cancel" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>
	
</odoo>